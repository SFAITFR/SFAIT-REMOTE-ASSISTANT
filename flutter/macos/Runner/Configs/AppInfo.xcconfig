// Application-level settings for the Runner target.
//
// This may be replaced with something auto-generated from metadata (e.g., pubspec.yaml) in the
// future. If not, the values below would default to using the project name when this becomes a
// 'flutter create' template.

// SFAIT edition: "client" (default, incoming connections only) or "technician" (full app).
// scripts/export-macos-github.sh passes SFAIT_EDITION=technician to xcodebuild for the
// technician build. Must match src/brand.rs.
SFAIT_EDITION = client
SFAIT_PRODUCT_NAME_client = SFAIT Remote Assistant
SFAIT_PRODUCT_NAME_technician = SFAIT Remote Assistant Technician
SFAIT_BUNDLE_IDENTIFIER_client = fr.sfait.remoteassistant
SFAIT_BUNDLE_IDENTIFIER_technician = fr.sfait.remoteassistant.technician
SFAIT_URI_SCHEME_client = sfaitremoteassistant
SFAIT_URI_SCHEME_technician = sfaitremoteassistanttechnician
SFAIT_URI_SCHEME = $(SFAIT_URI_SCHEME_$(SFAIT_EDITION))

// The application's name. By default this is also the title of the Flutter window.
PRODUCT_NAME = $(SFAIT_PRODUCT_NAME_$(SFAIT_EDITION))

// The application's bundle identifier
PRODUCT_BUNDLE_IDENTIFIER = $(SFAIT_BUNDLE_IDENTIFIER_$(SFAIT_EDITION))

// The copyright displayed in application information
PRODUCT_COPYRIGHT = Copyright © 2026 EI THOB ALAN - SFAIT.\n\nCopyright © 2026 Purslane Tech Pte. Ltd. All rights reserved.
